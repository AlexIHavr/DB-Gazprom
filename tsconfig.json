{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ESNext",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "src",
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@vtd/*": ["modules/vtd/*"],
      "@vtdTable/*": ["modules/vtdTable/*"],
    }
  },
  "exclude": ["node_modules", "dist", "client"],
  "include": ["src", "./*", ".eslintrc.cjs"]
}
